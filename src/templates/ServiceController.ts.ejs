import {
  ApiTags,
  ApiOkResponse,
  ApiBadRequestResponse,
  ApiOperation,
} from '@nestjs/swagger';
import { Body, Controller, <%= props.method %> } from '@nestjs/common';

import { ControllerBase } from '@/core/application/controller.base';

import { <%= props.name %>Service } from './<%= props.kebabedName %>.service';
import { <%= props.name %>RequestDto } from './dto/<%= props.kebabedName %>.request.dto';
import { <%= props.name %>ResponseDto } from './dto/<%= props.kebabedName %>.response.dto';

@ApiTags('<%= props.moduleName %>')
@Controller('<%= props.route %>')
export class <%= props.name %>Controller extends ControllerBase {
  constructor(private readonly <%= props.camelName %>Service: <%= props.name %>Service) {
    super();
  }

  @ApiOperation({ summary: '<%= props.name %>' })
  @ApiOkResponse({ type: <%= props.name %>ResponseDto })
  @ApiBadRequestResponse({ description: 'Bad Request' })
  @<%= props.method %>()
  async handle(<% if (['Post', 'Put', 'Patch'].includes(props.method)) { %>@Body() <% } %>request: <%= props.name %>RequestDto): Promise<<%= props.name %>ResponseDto> {
    const result = await this.<%= props.camelName %>Service.execute(request);

    if (result.isFailure) return this.handleErrorResponse(result.error);

    return result.value;
  }
}
